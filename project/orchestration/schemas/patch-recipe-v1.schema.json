{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://basara-foundry.local/schema/patch-recipe-v1.schema.json",
  "title": "BASARA Foundry Patch Recipe V1",
  "type": "object",
  "required": ["schema", "schema_version", "recipe_id", "source_snapshot_id", "identity", "providers", "candidate", "approval", "build", "runtime"],
  "properties": {
    "schema": {"const": "BASARA_FOUNDRY_PATCH_RECIPE_V1"},
    "schema_version": {"const": 1},
    "recipe_id": {"type": "string", "minLength": 1},
    "created_utc": {"type": "string"},
    "source_snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "type": "object",
      "required": ["type_hash", "canonical_path"],
      "properties": {
        "type_hash": {"type": "string", "pattern": "^0x[0-9A-F]{8}$"},
        "canonical_path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["arc_path", "arc_sha256", "member_index", "raw_sha256", "stored_sha256"],
        "properties": {
          "arc_path": {"type": "string"},
          "arc_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "member_index": {"type": "integer", "minimum": 0},
          "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "stored_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "actual_raw_size": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": true
      }
    },
    "candidate": {"type": "object"},
    "approval": {"type": "object"},
    "build": {"type": "object"},
    "runtime": {"type": "object"}
  },
  "additionalProperties": true
}
