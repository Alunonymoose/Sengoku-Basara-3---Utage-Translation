<Window
    x:Class="BasaraFoundry.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BASARA Foundry">

    <Grid Padding="24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="BASARA FOUNDRY" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Utage-first translation workstation · v0.1 vertical slice" Opacity="0.65" />
            </StackPanel>
            <Border Grid.Column="1" CornerRadius="8" Padding="12,8" Background="#183F2A">
                <TextBlock Text="CANONICAL SOURCES: READ ONLY" Foreground="#B9F6CA" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border CornerRadius="8" Padding="14" BorderBrush="#404040" BorderThickness="1">
                <TextBlock Text="Drop an RPCS3 screenshot here, or search for an asset…" Opacity="0.7" />
            </Border>
            <Button Grid.Column="1" Content="Search assets" Padding="18,10" />
            <Button Grid.Column="2" Content="Open asset" Padding="18,10" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="10" BorderBrush="#3D3D3D" BorderThickness="1" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="ORIGINAL JP" FontWeight="SemiBold" />
                    <Border Height="360" Background="#171717" CornerRadius="6">
                        <TextBlock Text="Source preview" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" CornerRadius="10" BorderBrush="#3D3D3D" BorderThickness="1" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="CURRENT ENG" FontWeight="SemiBold" />
                    <Border Height="360" Background="#171717" CornerRadius="6">
                        <TextBlock Text="Current build" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" CornerRadius="10" BorderBrush="#3D3D3D" BorderThickness="1" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="SAMURAI HEROES" FontWeight="SemiBold" />
                    <Border Height="360" Background="#171717" CornerRadius="6">
                        <TextBlock Text="Official reference" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" CornerRadius="10" BorderBrush="#5C8DD6" BorderThickness="2" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="WORKING" FontWeight="SemiBold" />
                    <Border Height="360" Background="#171717" CornerRadius="6">
                        <TextBlock Text="Editable candidate" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" CornerRadius="10" BorderBrush="#3D3D3D" BorderThickness="1" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="ENCODED RESULT" FontWeight="SemiBold" />
                    <Border Height="360" Background="#171717" CornerRadius="6">
                        <TextBlock Text="Game-format round trip" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" TextAlignment="Center" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                <TextBlock Text="Protected pixels: —" />
                <TextBlock Text="Dimensions: —" />
                <TextBlock Text="Dependency audit: —" />
                <TextBlock Text="Controller geometry: UNKNOWN" Foreground="#F6C344" />
            </StackPanel>
            <Button Grid.Column="1" Content="Send for approval" Padding="24,12" IsEnabled="False" />
        </Grid>
    </Grid>
</Window>
